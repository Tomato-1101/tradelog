// tradelog v1 スキーマ（ペーパートレード + SBI 実取引）。マイグレーションが正。
// 金額・数量は String（10 進数文字列）で持ち、計算は decimal.js で行う（浮動小数を経由させない）。
// 時刻はすべて UTC。足（Bar）の OHLC だけは表示・照合用なので Float でよい。

generator client {
  provider = "prisma-client"
  // Prisma 7 では output 必須。apps/web から相対 import するため apps/web/generated/prisma に出す。
  output   = "../apps/web/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // Prisma 7: url は apps/web/prisma.config.ts で指定する。
}

enum Source {
  PAPER
  SBI
  REPLAY // 録画を再生しながらの練習（data/paper/replay/events.jsonl）。ペーパーと同じ規則で確定し、別に一覧・集計する
}

enum Side {
  BUY
  SELL
}

enum Direction {
  LONG
  SHORT
}

enum OrderIntent {
  OPEN
  ADD
  CLOSE
}

enum OrderType {
  MARKET
  LIMIT
}

// MARKET: 成行 / PENDING: 指値の待機中（発注時に即約定できる指値もここに残り、約定は Execution の有無で判断）
// FILL_MARKED: 本人が「約定した」を押した / CANCELLED / EXPIRED: 引け後まで約定も取消も無かった指値
enum OrderState {
  MARKET
  PENDING
  FILL_MARKED
  CANCELLED
  EXPIRED
}

// ms: 時刻まで分かっている / day: 日付だけ（SBI の約定履歴 CSV には時刻が無い）
enum TimePrecision {
  ms
  day
}

enum MarginType {
  CASH
  MARGIN_LONG
  MARGIN_SHORT
}

enum PriceStatus {
  CONFIRMED
  NEEDS_REVIEW
  UNRESOLVED
}

enum PriceBasis {
  OPEN_AUCTION
  CLOSE_AUCTION
  SCREEN // 発注時の画面（手で囲んだ領域の読み取り）
  SCREEN_AUTO // 発注時の画面（小窓の自動読み取り。サイドカー ocr.json の auto.price）
  BAR
  LIMIT
  MANUAL
  CSV
}

enum RoundStatus {
  OPEN
  CLOSED
}

model Instrument {
  id         Int          @id @default(autoincrement())
  symbol     String // 東証コード（7203 / 285A）
  name       String?
  market     String       @default("TSE")
  executions Execution[]
  orders     PaperOrder[]
  rounds     Round[]
  bars       Bar[]
  barFetches BarFetch[]

  @@unique([market, symbol])
}

model PaperOrder {
  id           String      @id // order イベントの id
  positionId   String
  intent       OrderIntent
  side         Side
  qty          String
  orderType    OrderType
  limitPrice   String?
  placedAt     DateTime // UTC
  state        OrderState
  fillMarkedAt DateTime? // UTC（fill_mark イベントの ts）
  fillMarkId   String?     @unique
  cancelId     String?     @unique
  instrumentId Int
  instrument   Instrument  @relation(fields: [instrumentId], references: [id])
  shot         Shot?
  execution    Execution?
  rawJson      String // 取り込んだ order イベントそのもの
  // リプレイ（replay/events.jsonl の行）だけ埋まる。通常のペーパーは null（source は replayRecordingId の有無で決まる）
  replayRecordingId String? // 録画の rec_id（YYYYMMDD-HHMMSS）
  replaySessionId   String? // 練習 1 回ごとの UUID
  replayVideoMs     Int? // 押した瞬間の再生位置（録画の先頭からの ms）

  @@index([positionId])
  @@index([placedAt])
}

model Execution {
  id            String        @id @default(cuid())
  source        Source
  instrumentId  Int
  instrument    Instrument    @relation(fields: [instrumentId], references: [id])
  // Round のグルーピング用の口座識別。SBI は "default"、ペーパーは "paper"、リプレイは "replay"
  account       String        @default("default")
  // UTC。timePrecision=day のときは JST 当日 09:00（= UTC 00:00）を置く（日付だけが意味を持つ）
  executedAt    DateTime
  timePrecision TimePrecision
  side          Side
  qty           String
  price         String? // 未確定は null
  fee           String        @default("0")
  marginType    MarginType? // SBI 用
  priceStatus   PriceStatus
  priceBasis    PriceBasis?
  priceNote     String? // 要確認・未確定の理由（人と AI が読む）
  paperOrderId  String?       @unique
  paperOrder    PaperOrder?   @relation(fields: [paperOrderId], references: [id])
  dedupeHash    String?       @unique // SBI 用
  seq           Int           @default(0) // CSV 内の行順（同じ日の並べ替えに使う）
  importBatchId String?
  importBatch   ImportBatch?  @relation(fields: [importBatchId], references: [id])
  roundId       String?
  round         Round?        @relation(fields: [roundId], references: [id])
  rawJson       String

  @@index([instrumentId, executedAt])
  @@index([roundId])
}

// 建玉 0 → 0 の 1 サイクル。Execution が真実で、Round は再計算できるキャッシュ。
// ID は安定（PAPER = positionId / SBI = 先頭 Execution の dedupeHash 由来）。upsert で更新し、ID を変えない。
model Round {
  id            String        @id
  source        Source
  instrumentId  Int
  instrument    Instrument    @relation(fields: [instrumentId], references: [id])
  account       String
  marginType    MarginType?
  direction     Direction
  openedAt      DateTime
  closedAt      DateTime?
  timePrecision TimePrecision // 建て始めの約定の精度
  qtyOpened     String
  remainingQty  String
  // 価格が欠けた約定（未確定）を含むと計算できないので null
  avgEntryPrice String?
  avgExitPrice  String?
  remainingAvgPrice String? // 未決済分の平均建値（移動平均）。決済済みや価格欠けは null
  realizedPnl   String? // 手数料前
  fees          String
  netPnl        String? // 手数料込み（勝敗はこれで判定）
  holdSeconds   Int?
  // 建値からの最大逆行（<= 0）・最大順行（>= 0）。1 株あたりの値幅。1 分足が無ければ null
  mae           String?
  mfe           String?
  status        RoundStatus
  hasUnresolved Boolean // CONFIRMED 以外の価格を含む
  warningsJson  String        @default("[]")
  executions    Execution[]
  memos         Memo[]
  updatedAt     DateTime      @updatedAt

  @@index([source, openedAt])
  @@index([closedAt])
}

model Memo {
  id         String   @id // memo イベントの id
  positionId String
  roundId    String?
  round      Round?   @relation(fields: [roundId], references: [id])
  orderId    String?
  ts         DateTime // UTC
  text       String
  // リプレイのメモだけ埋まる（PaperOrder と同じ意味）
  replayRecordingId String?
  replaySessionId   String?
  replayVideoMs     Int?

  @@index([positionId])
}

model Shot {
  id           String     @id @default(cuid())
  paperOrderId String     @unique
  paperOrder   PaperOrder @relation(fields: [paperOrderId], references: [id])
  path         String // data/paper/ からの相対パス。ドテンの 2 注文は同じ path を共有する
  // 以下 4 つは手で囲んだ領域の読み取り結果
  priceText    String?
  price        String?
  symbolText   String?
  confidence   Float?
  capturedAt     DateTime? // 撮影完了時刻（UTC）
  captureDelayMs Int? // 撮影の遅れ = capturedAt − 発注時刻（ms）
  windowTitle    String?
  ocrPath        String? // サイドカー（data/paper/ からの相対パス）。order の後に非同期で書かれる
  // サイドカーの auto（画面全体の自動読み取り）。サイドカーを読めたときだけ埋まる
  ocrReadAt      DateTime?
  autoPrice      String?
  autoPriceText  String?
  autoPriceTime  String? // 画面に出ていた現在値の時刻（HH:MM）
  autoSymbol     String?
  autoSource     String? // region / label / null
}

model Bar {
  id           Int        @id @default(autoincrement())
  instrumentId Int
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  timeframe    String // "1m" | "1d"
  ts           DateTime // UTC。1m は分足の開始時刻、1d は JST 当日 00:00
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float
  source       String // "yahoo"
  fetchedAt    DateTime   @default(now())

  @@unique([instrumentId, timeframe, ts])
}

// 足の取得記録（データ品質）。銘柄 × 足の種類 × JST 日付ごとに、取れたか・何本か・失敗理由を残す。
model BarFetch {
  id           Int        @id @default(autoincrement())
  instrumentId Int
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  timeframe    String
  date         String // JST の YYYY-MM-DD
  status       String // OK / EMPTY / ERROR / UNAVAILABLE（遡れる期間外）
  complete     Boolean // 引け後に取得し、その日の足が出揃っている
  barCount     Int
  error        String?
  fetchedAt    DateTime   @default(now())

  @@unique([instrumentId, timeframe, date])
}

// SBI CSV の取り込み単位
model ImportBatch {
  id         String      @id @default(cuid())
  source     String // "sbi-csv"
  format     String // third-savefile / new-daily / legacy / unknown
  fileName   String
  fileSha256 String
  importedAt DateTime    @default(now())
  newCount   Int
  dupCount   Int
  warnings   String      @default("[]")
  executions Execution[]
}

// events.jsonl の取り込み済みイベント id（冪等化用）
model PaperEventLog {
  id         String   @id
  type       String
  ts         DateTime
  importedAt DateTime @default(now())
}
